{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT e.id, e.shelf_id, e.title, e.content, e.total_size,\n                e.created_at, e.updated_at\n            FROM entries e\n            JOIN shelves s ON s.id = e.shelf_id\n            JOIN workspaces w ON w.id = s.workspace_id\n            WHERE e.id = $1 AND w.user_id = $2\n        ",
