  "db_name": "PostgreSQL",
  "query": "\n            INSERT INTO entries (shelf_id, title, content)\n            SELECT $1, $2, $3\n            FROM shelves s\n            JOIN workspaces w ON w.id = s.workspace_id\n            WHERE s.id = $1 AND w.user_id = $4\n            RETURNING id, shelf_id, title, content, total_size, created_at, updated_at\n        ",
