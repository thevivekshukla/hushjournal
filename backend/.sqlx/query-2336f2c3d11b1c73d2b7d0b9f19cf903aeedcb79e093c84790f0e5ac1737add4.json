  "query": "\n            UPDATE workspaces\n            SET name = COALESCE($3, name),\n                key_salt = COALESCE($4, key_salt),\n                encrypted_dek = COALESCE($5, encrypted_dek)\n            WHERE id = $1 AND user_id = $2\n            RETURNING id, user_id, name, key_salt, encrypted_dek, created_at, updated_at\n        ",
