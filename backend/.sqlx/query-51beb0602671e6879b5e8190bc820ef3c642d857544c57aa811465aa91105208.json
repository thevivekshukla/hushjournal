  "query": "\n            SELECT s.id, s.workspace_id, s.name, s.icon, s.total_shelf_size,\n                s.size_last_calculated_at, s.created_at, s.updated_at\n            FROM shelves s\n            JOIN workspaces w ON w.id = s.workspace_id\n            WHERE s.id = $1 AND w.user_id = $2\n        ",
