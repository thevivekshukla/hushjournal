  "query": "\n            INSERT INTO shelves (workspace_id, name, icon)\n            SELECT $1, $2, $3\n            FROM workspaces\n            WHERE id = $1 AND user_id = $4\n            RETURNING id, workspace_id, name, icon, total_shelf_size,\n                size_last_calculated_at, created_at, updated_at\n        ",
